# Copy to `.env` and fill in your values. The `.env` file is gitignored.

# Required for any SEC EDGAR fetcher (used by the EDGAR/yfinance and ETF-filings
# backtests). SEC fair-access policy requires a real contact email in the
# User-Agent header — see https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT_EMAIL=your-email@example.com

# Optional. Required only if you run the WRDS-backed backtest
# (inverse_spx_backtest_wrds.py). You also need ~/.pgpass set up — see
# the WRDS section of the README.
WRDS_USERNAME=
